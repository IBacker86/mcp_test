    private Map<String, String> fixHeaders(HttpHeaders headers) {
        return headers.toSingleValueMap();
    }

    private String formatValidAccountNumber(Account account) {
        return account;
    }

    private String fixChannelId(String channelId) {
        return channelId;
    }

    private static String getMessageId() {
        LocalDateTime timeNow = LocalDateTime.now();
        return ConstantsNotification.TEMPLATE_ID_AJUSTE_TRANSACCIONAL +
                timeNow.format(Constants.DATE_TIME_FORMAT_MESSAGE_ID);
    }

    private String getDeviceAccessPrefix(UpdateAccountTransferLimitRequest request,
                                         CustomerRepository customerRepository) {
        Optional<CommonAccount> commonAccount = findCommonAccount(request, customerRepository);
        if (commonAccount.isPresent()) {
            return getDeviceAccessPrefixByCommonAccount(commonAccount.get());
        } else {
            return getDefaultDeviceAccessPrefix(request.getCustomer().getAccount().getAccountNumber());
        }
    }

    private String getDefaultDeviceAccessPrefix(String accountNumber) {
        if (accountNumber.length() < Constants.MAX_ACCOUNT_CHARACTERS) {
            return Constants.DEFAULT_BIN;
        } else {
            return Constants.DEFAULT_DEVICE_ACCESS_PREFIX;
        }
    }

    private String getProductName(UpdateAccountTransferLimitRequest request,
                                  CustomerRepository customerRepository) {
        Optional<CommonAccount> commonAccount = findCommonAccount(request, customerRepository);
        if (commonAccount.isPresent()) {
            return getProductNameByCommonAccount(commonAccount.get());
        } else {
            return request.getCustomer().getAccount().getProductName();
        }
    }

    private static Optional<CommonAccount> findCommonAccount(
            UpdateAccountTransferLimitRequest request,
            CustomerRepository customerRepository) {
        final Long sourceSearch = Long.parseLong(request.getCustomer().getAccount().getAccountNumber());
        return customerRepository.getAccounts().stream()
                .filter(account -> account.getAccountNumber().equals(sourceSearch.toString()) ||
                        (account.getDeviceAccessData() != null &&
                         account.getDeviceAccessData().stream()
                                 .anyMatch(da -> da.getDeviceAccessId().equals(sourceSearch.toString()))))
                .findFirst();
    }

    private String getDeviceAccessPrefixByCommonAccount(CommonAccount commonAccount) {
        int accountType = 0;
        if (commonAccount.getAccountType() != null) {
            accountType = commonAccount.getAccountType();
        }
        boolean existDeviceAccessData = commonAccount.getDeviceAccessData() != null &&
                !commonAccount.getDeviceAccessData().isEmpty();

        if (accountType == Constants.ONE || accountType == Constants.SIX || !existDeviceAccessData) {
            return commonAccount.getAccountAccessPrefix();
        } else {
            CommonDeviceAccess commonDeviceAccess = commonAccount.getDeviceAccessData().stream()
                    .filter(this::validCardHolderType)
                    .findFirst()
                    .orElse(null);
            return commonDeviceAccess != null ?
                    commonDeviceAccess.getDeviceAccessPrefix() :
                    commonAccount.getAccountAccessPrefix();
        }
    }

    private String getProductNameByCommonAccount(CommonAccount commonAccount) {
        int accountType = 0;
        if (commonAccount.getAccountType() != null) {
            accountType = commonAccount.getAccountType();
        }
        boolean existDeviceAccessData = commonAccount.getDeviceAccessData() != null &&
                !commonAccount.getDeviceAccessData().isEmpty();

        if (accountType == Constants.ONE || accountType == Constants.SIX || !existDeviceAccessData) {
            return commonAccount.getProductName();
        } else {
            CommonDeviceAccess commonDeviceAccess = commonAccount.getDeviceAccessData().stream()
                    .filter(this::validCardHolderType)
                    .findFirst()
                    .orElse(null);
            return commonDeviceAccess != null ?
                    commonDeviceAccess.getProductName() :
                    commonAccount.getProductName();
        }
    }

    private boolean validCardHolderType(CommonDeviceAccess commonDeviceAccess) {
        return commonDeviceAccess != null &&
                commonDeviceAccess.getCardHolderType().equalsIgnoreCase(Constants.PRIMARY);
    }
}