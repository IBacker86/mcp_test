    private CommonAccount buildCommonAccount(String accountNumber, String deviceAccessId) {
        List<CommonDeviceAccess> commonDeviceAccessList = new ArrayList<>();
        commonDeviceAccessList.add(buildCommonDeviceAccess(deviceAccessId));
        return CommonAccount.builder()
                .accountAccessPrefix("0000")
                .accountNumber(accountNumber)
                .branchId("0100")
                .displayAccountNumber("765")
                .productCode(1)
                .productInstrument(3)
                .customerId("116750120")
                .accountAssociationType(11)
                .deviceAccessData(commonDeviceAccessList)
                .accountType(1)
                .build();
    }

    private CommonDeviceAccess buildCommonDeviceAccess(String deviceAccessId) {
        return CommonDeviceAccess.builder()
                .deviceAccessId(deviceAccessId)
                .deviceAccessPrefix("7012")
                .deviceAccessStatus(21)
                .deviceAccessType(1)
                .cardHolderType("cardHolderType")
                .build();
    }

