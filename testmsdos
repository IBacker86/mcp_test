    // Crea request CON media access y tipo de cuenta específico
    RetrieveAccountTransferLimitRequest createRequestAccountMedia(int accountType) {
        ArrayList<AccountInfo> accountList = new ArrayList<>();
        ArrayList<AccountMediaAccess> accountMedia = new ArrayList<>();
        accountMedia.add(AccountMediaAccess.builder()
                .deviceAccessId("556677")
                .bankIdentificationNumber("12345")
                .build());

        AccountInfo accountInfo1 = getAccountInfo();
        accountInfo1.setAccountNumber("1234567812345678");
        if (accountType != 2) {
            accountInfo1.setAccountMediaAccess(accountMedia);
        }
        accountInfo1.setAccountType(accountType);

        AccountInfo accountInfo2 = getAccountInfo();
        accountInfo2.setAccountNumber("1234567812345678");
        if (accountType != 2) {
            accountInfo2.setAccountMediaAccess(accountMedia);
        }
        accountInfo2.setAccountType(accountType);

        accountList.add(accountInfo1);
        accountList.add(accountInfo2);

        // Actualiza la variable estática (opcional)
        accounts = Optional.ofNullable(Accounts.builder()
                .accountNumber(Long.valueOf(accountInfo1.getAccountNumber()))
                .accountId(Long.valueOf(accountInfo1.getAccountId()))
                .transferLimitAmount(BigDecimal.valueOf(200))
                .build());

        return RetrieveAccountTransferLimitRequest.builder()
                .customerInfo(CustomerInfo.builder()
                        .customerId("1234")
                        .customerType("General")
                        .phoneNumber("32565894541")
                        .accounts(accountList)
                        .device(Device.builder().deviceBrand("ANDROID").build())
                        .build())
                .build();
    }
