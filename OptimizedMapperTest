import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.*;
import java.util.concurrent.*;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class OptimizedMapperTest {

    private ObjectMapper mapper;
    private OptimizedMapper optimizedMapper;
    
    // Constantes simuladas para evitar depender de tu clase Constants en el test
    private static final String ORIGIN_MAP = "origin";
    private static final String STRATEG_KEY = "strategyKey";
    private static final String STRATEGIES = "strategies";
    private static final String COMMON_FIELDS = "commonFields";
    private static final String OPT_DEF_VALUE = "";

    @BeforeEach
    void setUp() {
        mapper = new ObjectMapper();
        
        // Cargamos el YAML manualmente en un Map para simular la clase MappingRulesConfig
        Map<String, Object> rulesConfigMap = new HashMap<>();
        
        // --- REGLAS DE APLICACIÓN (application) ---
        Map<String, Object> applicationRules = new HashMap<>();
        Map<String, Object> appFields = new HashMap<>();
        // Se traducen las expresiones de 'path(...)' a SpEL estándar para que el parser las entienda
        appFields.put("applicationId", "#this.path('applicationId').asText()");
        appFields.put("recordType", "#this.path('recordType')");
        appFields.put("channelSourceCode", "#this.path('systemIdentifier').asText()");
        appFields.put("priority", "#this.path('recordType').asText().equals('credit') ? 1 : 2");
        
        // --- CONFIGURACIÓN DEL ARRAY (applicationFiles) ---
        Map<String, Object> appFilesConfig = new HashMap<>();
        appFilesConfig.put(ORIGIN_MAP, "/applicationFiles");
        appFilesConfig.put(STRATEG_KEY, "#this.path('fileMetadata').path('documentType').asText()");
        
        Map<String, Object> commonFields = new HashMap<>();
        
        // Sub-mapa: document
        Map<String, Object> documentMap = new HashMap<>();
        documentMap.put("documentType", "#this.path('fileMetadata').path('documentType')");
        documentMap.put("documentName", "#this.path('fileMetadata').path('documentName')");
        documentMap.put("documentMimeType", "#this.path('fileMetadata').path('documentMimeType')");
        documentMap.put("documentSize", "#this.path('fileMetadata').path('documentsize')");
        
        // Sub-mapa: fileInfo
        Map<String, Object> fileInfoCommonMap = new HashMap<>();
        fileInfoCommonMap.put("documentPath", "#this.path('documentInfo').path('documentStoragePath')");
        fileInfoCommonMap.put("fileName", "#this.path('documentInfo').path('fileName')");
        
        commonFields.put("fileMetadata", Map.of("document", documentMap)); // Necesario para que el test de mapeo pase
        commonFields.put("fileInfo", fileInfoCommonMap);
        
        appFilesConfig.put(COMMON_FIELDS, commonFields);
        
        applicationRules.put("applicationFiles", appFilesConfig);
        rulesConfigMap.put("application", applicationRules);

        // --- ESTRATEGIAS (strategies) ---
        Map<String, Map<String, Object>> strategiesMap = new HashMap<>();
        
        // 1. Estrategia cbfVotingCard
        Map<String, Object> cbfVotingCard = new HashMap<>();
        cbfVotingCard.put("fileInfo", Map.of("creditApplicationId", "#rootNode.path('applicationReferenceNumber')"));
        cbfVotingCard.put("fileMetadata", Map.of(
            "customer", Map.of(
                "customerId", "#this.path('fileMetadata').path('customerId').asText()",
                "curr", "#this.path('fileMetadata').path('curr')"
            ),
            "document", Map.of(
                "expiryDate", "#this.path('fileMetadata').path('documentExpirationDate')",
                "documentStatus", "#this.path('fileMetadata').path('documentStatus')"
            )
        ));
        strategiesMap.put("cbfVotingCard", cbfVotingCard);

        // 2. Estrategia cbfVotingCardProofOfResidency (Misma estructura)
        Map<String, Object> cbfProof = new HashMap<>(cbfVotingCard); // Copia superficial para simplificar el test
        strategiesMap.put("cbfVotingCardProofOfResidency", cbfProof);

        // 3. Estrategia cbfIdentification (Usa curp)
        Map<String, Object> cbfIdentification = new HashMap<>();
        cbfIdentification.put("fileInfo", Map.of("creditApplicationId", "#rootNode.path('applicationReferenceNumber')"));
        cbfIdentification.put("fileMetadata", Map.of(
            "customer", Map.of(
                "customerId", "#this.path('fileMetadata').path('customerId').asText()",
                "curp", "#this.path('fileMetadata').path('curp')"
            ),
            "document", Map.of(
                "expiryDate", "#this.path('fileMetadata').path('documentExpirationDate')",
                "documentStatus", "#this.path('fileMetadata').path('documentStatus')"
            )
        ));
        strategiesMap.put("cbfIdentification", cbfIdentification);

        // 4. Estrategia cbfPassport (Usa curp)
        Map<String, Object> cbfPassport = new HashMap<>(cbfIdentification);
        strategiesMap.put("cbfPassport", cbfPassport);

        appFilesConfig.put(STRATEGIES, strategiesMap);

        // --- CONSTRUCCIÓN DE LA CONFIGURACIÓN FINAL ---
        // Asumimos que MappingRulesConfig tiene un método setRules(Map<String, Object>)
        // Si tu clase real es distinta, ajusta esta línea a tu constructor o setter real.
        MappingRulesConfig config = new MappingRulesConfig();
        config.setRules(rulesConfigMap);

        optimizedMapper = new OptimizedMapper(mapper, config);
    }

    // Test 1: Transformación básica de los campos de aplicación
    @Test
    void testTransformApplicationFields() throws Exception {
        String jsonInput = "{\"applicationId\": \"APP-123\", \"recordType\": \"credit\", \"systemIdentifier\": \"WEB\"}";
        JsonNode input = mapper.readTree(jsonInput);
        
        JsonNode result = optimizedMapper.transform(input);
        
        assertNotNull(result);
        assertEquals("APP-123", result.get("application").get("applicationId").asText());
        assertEquals("credit", result.get("application").get("recordType").asText());
        assertEquals("WEB", result.get("application").get("channelSourceCode").asText());
        assertEquals(1, result.get("application").get("priority").asInt()); // Crédito = 1
    }

    // Test 2: Estrategias del Array (applicationFiles) - Common Fields y Estrategia específica
    @Test
    void testTransformArrayWithStrategies() throws Exception {
        // Creamos un JSON que simula el nodo root
        String jsonInput = "{\n" +
                "  \"applicationReferenceNumber\": \"REF-999\",\n" +
                "  \"applicationFiles\": [\n" +
                "    {\n" +
                "      \"fileMetadata\": { \"documentType\": \"cbfVotingCard\", \"customerId\": \"CUST-1\", \"curr\": \"MXN\", \"documentExpirationDate\": \"2030-01-01\", \"documentStatus\": \"ACTIVE\" },\n" +
                "      \"documentInfo\": { \"documentStoragePath\": \"/storage/ine.pdf\", \"fileName\": \"ine.pdf\" }\n" +
                "    }\n" +
                "  ]\n" +
                "}";
        JsonNode input = mapper.readTree(jsonInput);
        
        JsonNode result = optimizedMapper.transform(input);
        
        // Verificamos que exista el array y tenga 1 elemento
        JsonNode applicationNode = result.get("application");
        assertNotNull(applicationNode);
        assertTrue(applicationNode.has("applicationFiles"));
        assertTrue(applicationNode.get("applicationFiles").isArray());
        assertEquals(1, applicationNode.get("applicationFiles").size());
        
        JsonNode item = applicationNode.get("applicationFiles").get(0);
        
        // Verificar commonFields aplicados
        assertEquals("/storage/ine.pdf", item.get("fileInfo").get("documentPath").asText());
        assertEquals("ine.pdf", item.get("fileInfo").get("fileName").asText());
        
        // Verificar estrategia cbfVotingCard aplicada
        assertEquals("REF-999", item.get("fileInfo").get("creditApplicationId").asText());
        assertEquals("CUST-1", item.get("fileMetadata").get("customer").get("customerId").asText());
        assertEquals("MXN", item.get("fileMetadata").get("customer").get("curr").asText());
    }

    // Test 3: Estrategia alternativa (cbfIdentification con curp)
    @Test
    void testTransformWithAlternativeStrategy() throws Exception {
        String jsonInput = "{\n" +
                "  \"applicationReferenceNumber\": \"REF-456\",\n" +
                "  \"applicationFiles\": [\n" +
                "    {\n" +
                "      \"fileMetadata\": { \"documentType\": \"cbfIdentification\", \"customerId\": \"CUST-2\", \"curp\": \"CURP123456\" },\n" +
                "      \"documentInfo\": { \"documentStoragePath\": \"/storage/id.pdf\", \"fileName\": \"id.pdf\" }\n" +
                "    }\n" +
                "  ]\n" +
                "}";
        JsonNode input = mapper.readTree(jsonInput);
        
        JsonNode result = optimizedMapper.transform(input);
        JsonNode item = result.get("application").get("applicationFiles").get(0);
        
        assertEquals("REF-456", item.get("fileInfo").get("creditApplicationId").asText());
        assertEquals("CURP123456", item.get("fileMetadata").get("customer").get("curp").asText());
        // 'curr' no debería existir en esta estrategia
        assertFalse(item.get("fileMetadata").get("customer").has("curr"));
    }

    // Test 4: USO DE EXECUTOR SERVICE (Concurrencia en Caché de Expresiones)
    @Test
    void testTransformConcurrentWithExecutorService() throws Exception {
        String jsonInput = "{\n" +
                "  \"applicationReferenceNumber\": \"REF-CONCURRENT\",\n" +
                "  \"applicationFiles\": [\n" +
                "    { \"fileMetadata\": { \"documentType\": \"cbfPassport\", \"customerId\": \"CUST-X\", \"curp\": \"CURPX\" }, \"documentInfo\": { \"documentStoragePath\": \"/p.pdf\", \"fileName\": \"p.pdf\" } }\n" +
                "  ]\n" +
                "}";
        JsonNode input = mapper.readTree(jsonInput);
        
        int numberOfThreads = 8;
        int numberOfTasks = 50;
        ExecutorService executor = Executors.newFixedThreadPool(numberOfThreads);
        
        try {
            List<Future<JsonNode>> futures = new ArrayList<>();
            
            // Lanzar 50 tareas simultáneas (forzará el uso del ConcurrentHashMap del caché)
            for (int i = 0; i < numberOfTasks; i++) {
                futures.add(executor.submit(() -> optimizedMapper.transform(input)));
            }
            
            // Validar que todos los resultados sean exitosos y consistentes
            for (Future<JsonNode> future : futures) {
                JsonNode result = future.get(5, TimeUnit.SECONDS);
                assertNotNull(result);
                assertEquals("REF-CONCURRENT", result.get("application").get("applicationFiles").get(0).get("fileInfo").get("creditApplicationId").asText());
                assertEquals("CURPX", result.get("application").get("applicationFiles").get(0).get("fileMetadata").get("customer").get("curp").asText());
            }
            
        } catch (ExecutionException | InterruptedException e) {
            fail("Error durante la ejecución concurrente: " + e.getMessage());
        } finally {
            executor.shutdown();
            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS));
        }
    }
}
